# ============================================================
# SolarOps AI — environment variables
# The app runs 100% in demo mode with NO variables set.
# ============================================================

# ---- Supabase (optional: enables real auth + persistent cloud DB) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side only — never expose in frontend bundles:
SUPABASE_SERVICE_ROLE_KEY=

# ---- OpenAI / SolarBot AI Assistant (optional: enables live AI assistants) ----
# The frontend connects to a secure server-side proxy (e.g. Supabase Edge Function).
# Secret keys must NEVER be exposed in VITE_ variables.
VITE_OPENAI_PROXY_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Google Maps (optional: upgrades OSM map to Google Maps) ----
VITE_GOOGLE_MAPS_API_KEY=
