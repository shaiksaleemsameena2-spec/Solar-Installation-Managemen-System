# ============================================================
# SolarOps AI — environment variables template
# The app runs 100% in demo mode with NO variables set.
# ============================================================

# ---- OpenAI / SolarBot AI Assistant (Optional: enables live AI) ----
# Server-side secret key (NEVER prefix with VITE_ — kept strictly on the server):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend Proxy URL:
# - For local Vite development & Vercel deployment (Recommended):
#   VITE_OPENAI_PROXY_URL=/api/ai-proxy
# - For Supabase Edge Function deployment:
#   VITE_OPENAI_PROXY_URL=https://<YOUR_PROJECT_REF>.supabase.co/functions/v1/ai-proxy
VITE_OPENAI_PROXY_URL=/api/ai-proxy

# ---- Supabase (optional: enables real auth + persistent cloud DB) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side only — never expose in frontend bundles:
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Maps (optional: upgrades OSM map to Google Maps) ----
VITE_GOOGLE_MAPS_API_KEY=
